
.lpvm-backdrop {

  position: fixed;

  inset: 0;

  z-index: 2147483000;

  background:

    radial-gradient(circle at 50% 18%, rgba(214, 178, 119, 0.08), transparent 30%),

    repeating-linear-gradient(

      0deg,

      rgba(255,255,255,0.014) 0,

      rgba(255,255,255,0.014) 1px,

      transparent 1px,

      transparent 8px

    ),

    rgba(0, 0, 0, 0.94);

  color: #fff;

  overflow: hidden;

}

.lpvm-modal {

  position: relative;

  width: min(1200px, calc(100vw - 44px));

  height: calc(100svh - 124px);

  margin: 96px auto 28px;

  display: grid;

  grid-template-rows: auto auto minmax(0, 1fr);

  overflow: hidden;

}

.lpvm-close {

  position: absolute;

  top: 14px;

  right: 0;

  z-index: 20;

  width: 42px;

  height: 42px;

  border-radius: 999px;

  border: 1px solid rgba(214, 178, 119, 0.18);

  background: rgba(255, 255, 255, 0.04);

  color: rgba(255, 255, 255, 0.72);

  font-size: 1.45rem;

  cursor: pointer;

}

.lpvm-header {

  padding-right: 58px;

  border-bottom: 1px solid rgba(214, 178, 119, 0.12);

}

.lpvm-kicker,

.lpvm-panel-kicker {

  display: block;

  color: rgba(214, 178, 119, 0.9);

  font-size: 0.68rem;

  font-weight: 900;

  letter-spacing: 0.22em;

  text-transform: uppercase;

}

.lpvm-header h2 {

  margin: 6px 0 8px;

  font-size: clamp(3rem, 6vw, 5.5rem);

  line-height: 0.82;

  letter-spacing: -0.09em;

}

.lpvm-header p {

  margin: 0 0 14px;

  color: rgba(255, 255, 255, 0.76);

  font-size: 1rem;

}

.lpvm-mode-tabs {

  width: min(880px, 100%);

  margin: 18px auto 0;

  display: grid;

  grid-template-columns: repeat(4, minmax(0, 1fr));

  gap: 10px;

}

.lpvm-mode-tab {

  min-height: 48px;

  padding: 10px 13px;

  border-radius: 12px;

  border: 1px solid rgba(255, 255, 255, 0.08);

  background:

    linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.018)),

    rgba(0,0,0,0.3);

  color: rgba(255, 255, 255, 0.76);

  text-align: left;

  cursor: pointer;

}

.lpvm-mode-tab strong,

.lpvm-mode-tab span {

  display: block;

}

.lpvm-mode-tab strong {

  font-size: 0.73rem;

  letter-spacing: 0.12em;

  text-transform: uppercase;

}

.lpvm-mode-tab span {

  margin-top: 2px;

  font-size: 0.62rem;

  color: rgba(255, 255, 255, 0.52);

}

.lpvm-mode-tab.is-active {

  border-color: rgba(214, 178, 119, 0.44);

  background:

    radial-gradient(circle at top left, rgba(214, 178, 119, 0.13), transparent 55%),

    rgba(255,255,255,0.04);

  color: #fff;

}

.lpvm-workspace {

  min-height: 0;

  display: grid;

  grid-template-columns: minmax(420px, 1fr) minmax(330px, 390px);

  align-items: center;

  gap: clamp(30px, 5vw, 70px);

  padding: 20px 0 0;

}

.lpvm-visual {

  min-width: 0;

  display: grid;

  place-items: center;

}

.lpvm-map {

  position: relative;

  width: min(520px, 43vw, 58svh);

  aspect-ratio: 1;

  overflow: visible;

}

.lpvm-svg {

  width: 100%;

  height: 100%;

  overflow: visible;

}

.lpvm-play-cycle-ring {

  fill: none;

  stroke: rgba(214, 178, 119, 0.18);

  stroke-width: 0.8;

}

.lpvm-play-cycle-arrow {

  stroke-width: 1.25;

  stroke-linecap: round;

  filter: drop-shadow(0 0 6px rgba(214, 178, 119, 0.2));

}

.lpvm-spider-grid {

  fill: none;

  stroke: rgba(255, 255, 255, 0.09);

  stroke-width: 0.35;

}

.lpvm-spider-grid.is-reference-level {

  stroke: rgba(255, 255, 255, 0.34);

  stroke-width: 0.55;

  stroke-dasharray: 2.2 2.2;

}

.lpvm-spider-axis {

  stroke: rgba(255, 255, 255, 0.075);

  stroke-width: 0.35;

}

.lpvm-reference-polygon {

  fill: none;

  stroke: rgba(255, 255, 255, 0.42);

  stroke-width: 0.75;

  stroke-dasharray: 2.2 2.2;

}

.lpvm-current-fill {

  fill: rgba(214, 178, 119, 0.12);

  stroke: rgba(255,255,255,0.08);

  stroke-width: 0.3;

}

.lpvm-current-segment {

  stroke-width: 1.85;

  stroke-linecap: round;

  filter:

    drop-shadow(0 0 2px rgba(255,255,255,0.18))

    drop-shadow(0 0 9px rgba(214,178,119,0.24));

}

.lpvm-spider-dot {

  cursor: pointer;

  pointer-events: auto;

  filter: drop-shadow(0 0 7px currentColor);

}

.lpvm-spider-dot.is-active {

  r: 2.8;

}

.lpvm-spider-dot-hit {

  cursor: pointer;

  pointer-events: auto;

}

.lpvm-bars-svg {

  transform: translateY(5px);

}

.lpvm-bar-track,

.lpvm-bar-fill {

  stroke-linecap: round;

  stroke-width: 2.5;

}

.lpvm-bar-track {

  stroke: rgba(255, 255, 255, 0.1);

}

.lpvm-bar-fill {

  filter: drop-shadow(0 0 7px rgba(214, 178, 119, 0.24));

  cursor: pointer;

  pointer-events: auto;

}

.lpvm-relationship-line {

  stroke-width: 0.55;

  stroke-linecap: round;

  opacity: 0.78;

}

.lpvm-relationship-line.is-active {

  stroke-width: 1.85;

  opacity: 1;

  filter: drop-shadow(0 0 8px rgba(214, 178, 119, 0.28));

}

.lpvm-relationship-hitline {

  stroke: transparent;

  stroke-width: 5;

  cursor: pointer;

  pointer-events: stroke;

}

.lpvm-finder-line {

  stroke-width: 0.65;

  opacity: 0.28;

  stroke-linecap: round;

}

.lpvm-finder-line.is-active {

  stroke-width: 1.6;

  opacity: 0.95;

  filter: drop-shadow(0 0 10px rgba(214, 178, 119, 0.22));

}

.lpvm-node-button {

  position: absolute;

  left: var(--node-x);

  top: var(--node-y);

  width: 46px;

  height: 46px;

  transform: translate(-50%, -50%);

  display: grid;

  place-items: center;

  border: 0;

  background: transparent;

  color: var(--node-color);

  cursor: pointer;

  pointer-events: auto;

  filter:

    drop-shadow(0 0 10px color-mix(in srgb, var(--node-color) 52%, transparent))

    drop-shadow(0 0 22px color-mix(in srgb, var(--node-color) 18%, transparent));

  transition: transform 160ms ease, filter 160ms ease, opacity 160ms ease;

}

.lpvm-node-button:hover,

.lpvm-node-button:focus-visible,

.lpvm-node-button.is-active {

  transform: translate(-50%, -50%) scale(1.12);

  outline: none;

  filter:

    drop-shadow(0 0 14px color-mix(in srgb, var(--node-color) 72%, transparent))

    drop-shadow(0 0 28px color-mix(in srgb, var(--node-color) 28%, transparent));

}

.lpvm-node-button svg {

  width: 21px;

  height: 21px;

  pointer-events: none;

}

.lpvm-map-voiceGauge .lpvm-node-button {

  transform: translate(-50%, -50%) scale(0.9);

}

.lpvm-map-voiceGauge .lpvm-node-button:hover,

.lpvm-map-voiceGauge .lpvm-node-button:focus-visible,

.lpvm-map-voiceGauge .lpvm-node-button.is-active {

  transform: translate(-50%, -50%) scale(1.02);

}

.lpvm-panel {

  align-self: center;

  max-height: min(470px, calc(100svh - 330px));

  overflow: hidden;

  padding: 24px 24px 22px;

  border-radius: 22px;

  border: 1px solid rgba(214, 178, 119, 0.14);

  background:

    radial-gradient(circle at top left, rgba(214, 178, 119, 0.08), transparent 42%),

    linear-gradient(180deg, rgba(16,16,17,0.86), rgba(7,7,8,0.9));

  box-shadow:

    0 24px 60px rgba(0,0,0,0.38),

    inset 0 1px 0 rgba(255,255,255,0.045);

}

.lpvm-panel h3 {

  margin: 8px 0 12px;

  font-size: clamp(1.65rem, 2.5vw, 2.2rem);

  line-height: 0.95;

  letter-spacing: -0.06em;

}

.lpvm-panel p {

  margin: 0;

  color: rgba(255, 255, 255, 0.76);

  font-size: 0.9rem;

  line-height: 1.45;

}

.lpvm-submode-grid,

.lpvm-motion-grid,

.lpvm-relationship-buttons {

  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: 8px;

  margin-top: 16px;

}

.lpvm-submode-grid button,

.lpvm-motion-chip,

.lpvm-relationship-buttons button,

.lpvm-finder-question button,

.lpvm-finder-result button {

  min-height: 34px;

  border-radius: 11px;

  border: 1px solid rgba(255,255,255,0.075);

  background: rgba(255,255,255,0.032);

  color: rgba(255,255,255,0.76);

  font-size: 0.64rem;

  font-weight: 850;

  letter-spacing: 0.08em;

  text-transform: uppercase;

  cursor: pointer;

}

.lpvm-submode-grid button.is-active,

.lpvm-motion-chip.is-active,

.lpvm-relationship-buttons button.is-active {

  border-color: rgba(214, 178, 119, 0.42);

  color: #f3dfbd;

  background: rgba(214, 178, 119, 0.075);

}

.lpvm-motion-chip {

  display: flex;

  align-items: center;

  justify-content: flex-start;

  gap: 7px;

  padding: 0 10px;

}

.lpvm-motion-chip span {

  opacity: 0.42;

}

.lpvm-overall-read,

.lpvm-node-readout,

.lpvm-relationship-card,

.lpvm-finder-question,

.lpvm-finder-result,

.lpvm-output {

  margin-top: 14px;

  border-radius: 15px;

  border: 1px solid rgba(255,255,255,0.08);

  background: rgba(0,0,0,0.22);

}

.lpvm-overall-read,

.lpvm-node-readout,

.lpvm-relationship-card,

.lpvm-finder-question,

.lpvm-finder-result {

  padding: 13px 14px;

}

.lpvm-overall-read span,

.lpvm-output strong,

.lpvm-panel-kicker {

  color: rgba(214, 178, 119, 0.88);

  font-weight: 900;

  letter-spacing: 0.14em;

  text-transform: uppercase;

}

.lpvm-overall-read span {

  display: block;

  margin-bottom: 6px;

  font-size: 0.62rem;

}

.lpvm-node-readout {

  border-color: color-mix(in srgb, var(--node-color) 34%, rgba(255,255,255,0.08));

}

.lpvm-node-readout-head {

  display: flex;

  align-items: center;

  gap: 10px;

  margin-bottom: 9px;

}

.lpvm-node-readout-head strong,

.lpvm-relationship-card strong,

.lpvm-finder-question strong,

.lpvm-finder-result strong {

  display: block;

  color: #fff;

  font-size: 0.95rem;

  line-height: 1.1;

}

.lpvm-node-readout-head span,

.lpvm-relationship-card small {

  display: block;

  margin-top: 3px;

  color: color-mix(in srgb, var(--node-color, #d6b277) 72%, #fff 28%);

  font-size: 0.6rem;

  font-weight: 900;

  letter-spacing: 0.12em;

  text-transform: uppercase;

}

.lpvm-node-readout small {

  display: block;

  margin-top: 8px;

  color: rgba(255,255,255,0.54);

  font-size: 0.72rem;

  line-height: 1.35;

}

.lpvm-relationship-buttons {

  max-height: 116px;

  overflow: hidden;

}

.lpvm-finder-question div {

  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: 8px;

  margin-top: 12px;

}

.lpvm-output {

  display: grid;

  gap: 4px;

  padding: 12px 13px;

}

.lpvm-output strong {

  font-size: 0.62rem;

}

.lpvm-output span {

  color: rgba(255,255,255,0.62);

  font-size: 0.78rem;

  line-height: 1.35;

}

@media (max-width: 900px) {

  .lpvm-modal {

    width: calc(100vw - 22px);

    height: calc(100svh - 112px);

    margin-top: 86px;

  }

  .lpvm-header h2 {

    font-size: clamp(2.1rem, 10vw, 3.4rem);

  }

  .lpvm-mode-tabs {

    grid-template-columns: repeat(2, minmax(0, 1fr));

  }

  .lpvm-workspace {

    grid-template-columns: 1fr;

    gap: 12px;

    align-items: start;

    overflow: hidden;

  }

  .lpvm-map {

    width: min(390px, 82vw, 42svh);

  }

  .lpvm-panel {

    width: min(520px, 100%);

    margin: 0 auto;

    max-height: 260px;

    padding: 16px;

  }

}


/* -------------------------------------------------------------------------- */

/* Voice Gauge connector polish — gradient glow like product spider chart      */

/* -------------------------------------------------------------------------- */

.oad-master-polygon-voiceGauge .oad-master-gauge-current-segment-glow {

  stroke-width: 7.5 !important;

  stroke-linecap: round !important;

  stroke-linejoin: round !important;

  vector-effect: non-scaling-stroke !important;

  opacity: 0.22 !important;

  filter:

    blur(0.65px)

    drop-shadow(0 0 12px rgba(214, 178, 119, 0.3))

    drop-shadow(0 0 24px rgba(141, 162, 255, 0.12)) !important;

}

.oad-master-polygon-voiceGauge .oad-master-gauge-current-segment {

  stroke-width: 3.15 !important;

  stroke-linecap: round !important;

  stroke-linejoin: round !important;

  vector-effect: non-scaling-stroke !important;

  opacity: 0.99 !important;

  filter:

    drop-shadow(0 0 5px rgba(214, 178, 119, 0.42))

    drop-shadow(0 0 14px rgba(214, 178, 119, 0.18)) !important;

}

/* Push Voice Gauge node icons outside the spider readout */

.oad-master-polygon-voiceGauge .oad-master-node {

  z-index: 12 !important;

  width: clamp(34px, 4.2vw, 48px) !important;

  height: clamp(34px, 4.2vw, 48px) !important;

  min-height: clamp(34px, 4.2vw, 48px) !important;

}

.oad-master-polygon-voiceGauge .oad-master-node svg {

  width: clamp(24px, 2.9vw, 34px) !important;

  height: clamp(24px, 2.9vw, 34px) !important;

  stroke-width: 2.35 !important;

}

/* Keep spider web faint so the current shape stays dominant */

.oad-master-polygon-voiceGauge .oad-master-gauge-grid {

  stroke: rgba(255, 255, 255, 0.095) !important;

  opacity: 0.68 !important;

}

.oad-master-polygon-voiceGauge .oad-master-gauge-axis {

  stroke: rgba(255, 255, 255, 0.095) !important;

  opacity: 0.62 !important;

}

.oad-master-polygon-voiceGauge .oad-master-gauge-reference {

  stroke: rgba(255, 255, 255, 0.42) !important;

  stroke-width: 1.05 !important;

  stroke-dasharray: 1.7 1.9 !important;

  opacity: 0.68 !important;

}

/* Let node icons feel external, not like clickable pills */

.oad-master-polygon-voiceGauge .oad-master-node:hover,

.oad-master-polygon-voiceGauge .oad-master-node:focus-visible,

.oad-master-polygon-voiceGauge .oad-master-node.is-active {

  transform: translate(-50%, -50%) scale(1.08) !important;

}

@media (max-width: 820px) {

  .oad-master-polygon-voiceGauge .oad-master-gauge-current-segment-glow {

    stroke-width: 6.25 !important;

  }

  .oad-master-polygon-voiceGauge .oad-master-gauge-current-segment {

    stroke-width: 2.65 !important;

  }

  .oad-master-polygon-voiceGauge .oad-master-node {

    width: 32px !important;

    height: 32px !important;

    min-height: 32px !important;

  }

  .oad-master-polygon-voiceGauge .oad-master-node svg {

    width: 22px !important;

    height: 22px !important;

  }

}


/* -------------------------------------------------------------------------- */

/* Play Cycle v2 — clean circular listening path                              */

/* -------------------------------------------------------------------------- */

.oad-master-polygon-playCycle .oad-master-polygon-segment-glow,

.oad-master-polygon-playCycle .oad-master-polygon-segment-main {

  display: none !important;

}

.oad-master-polygon-playCycle .oad-master-cycle-guide-ring {

  fill: none !important;

  stroke: rgba(214, 178, 119, 0.26) !important;

  stroke-width: 1.15 !important;

  vector-effect: non-scaling-stroke !important;

  filter:

    drop-shadow(0 0 6px rgba(214, 178, 119, 0.16))

    drop-shadow(0 0 18px rgba(214, 178, 119, 0.08)) !important;

}

.oad-master-polygon-playCycle .oad-master-cycle-arrow {

  fill: none !important;

  stroke: rgba(214, 178, 119, 0.24) !important;

  stroke-width: 1.2 !important;

  stroke-linecap: round !important;

  vector-effect: non-scaling-stroke !important;

  opacity: 0.44 !important;

  filter: none !important;

}

.oad-master-polygon-playCycle .oad-master-cycle-arrow.is-active {

  stroke: rgba(214, 178, 119, 0.98) !important;

  stroke-width: 2.8 !important;

  opacity: 1 !important;

  filter:

    drop-shadow(0 0 8px rgba(214, 178, 119, 0.74))

    drop-shadow(0 0 20px rgba(214, 178, 119, 0.28)) !important;

}

.oad-master-polygon-playCycle .oad-master-node {

  width: clamp(52px, 6.2vh, 66px) !important;

  height: clamp(52px, 6.2vh, 66px) !important;

}

.oad-master-polygon-playCycle .oad-master-node.is-active {

  transform: translate(-50%, -50%) scale(1.16) !important;

}

@media (max-width: 980px) {

  .oad-master-polygon-playCycle .oad-master-cycle-guide-ring {

    stroke-width: 1.35 !important;

  }

  .oad-master-polygon-playCycle .oad-master-cycle-arrow.is-active {

    stroke-width: 3.1 !important;

  }

}

