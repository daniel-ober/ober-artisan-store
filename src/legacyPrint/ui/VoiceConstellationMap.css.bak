/* =========================================================

   VOICE PLAYGROUND — HIDE STRAY SIMILARITY / DASH MARKS

   ========================================================= */

.vcm-similarity,
.vcm-similarity *,
.vcm-similarity-center,
.vcm-similarity-bar {
  display: none !important;

  opacity: 0 !important;

  visibility: hidden !important;

  pointer-events: none !important;
}

/* Extra safety: hide any leftover decorative dash artifacts */

.vcm-shell .vcm-dash-strip,
.vcm-shell .vcm-dash-line,
.vcm-shell .vcm-map-dashes,
.vcm-shell .vcm-similarity::before,
.vcm-shell .vcm-similarity::after,
.vcm-shell .vcm-map-frame::before,
.vcm-shell .vcm-map-frame::after {
  display: none !important;

  content: none !important;

  opacity: 0 !important;

  visibility: hidden !important;
}

/* =========================================================

   VOICE PLAYGROUND — REMOVE STRAY CLICK TARGET DASHES

   ========================================================= */

.vcm-node-click-layer,
.vcm-node-click-layer *,
.vcm-node-click-target {
  display: none !important;

  opacity: 0 !important;

  visibility: hidden !important;

  pointer-events: none !important;

  appearance: none !important;

  border: 0 !important;

  background: transparent !important;

  box-shadow: none !important;
}

/* =========================================================

   VOICE PLAYGROUND — THREADMAP OVERLAY CLEANUP

   Keep the Heritage/VoiceThreadMap visual, but remove duplicate

   top/bottom copy layers inside the Playground adapter.

   ========================================================= */

/* The imported VoiceThreadMap already carries read-context copy.

   Hide the extra adapter badge so the top title area stops doubling. */

.vcm-shell--threadmap .vcm-read-badge {
  display: none !important;

  opacity: 0 !important;

  visibility: hidden !important;

  pointer-events: none !important;
}

/* Reclaim the space the hidden badge was visually occupying. */

.vcm-shell--threadmap {
  min-height: 510px !important;

  overflow: visible !important;
}

.vcm-shell--threadmap .vcm-map-frame {
  height: 455px !important;

  margin: 0 auto !important;

  overflow: hidden !important;
}

/* Center the imported Heritage/VoiceThreadMap visual in the available frame. */

.vcm-shell--threadmap .heritage-voice-thread-map {
  width: 100% !important;

  max-width: 650px !important;

  margin: 0 auto !important;

  transform: translateY(-18px) scale(0.96) !important;

  transform-origin: center top !important;
}

/* Hide text-only read/caption blocks INSIDE the imported VoiceThreadMap.

   This preserves the triangle/spider/blob + icons, but removes the duplicate

   "FIRST LISTEN / PROJECTION → ..." and description text that was colliding

   with the Playground summary and tabs. */

.vcm-shell--threadmap .heritage-voice-thread-map h1,
.vcm-shell--threadmap .heritage-voice-thread-map h2,
.vcm-shell--threadmap .heritage-voice-thread-map h3,
.vcm-shell--threadmap .heritage-voice-thread-map h4,
.vcm-shell--threadmap .heritage-voice-thread-map p,
.vcm-shell--threadmap .heritage-voice-thread-map small,
.vcm-shell--threadmap .heritage-voice-thread-map figcaption,
.vcm-shell--threadmap .heritage-voice-thread-map [class*='caption'],
.vcm-shell--threadmap .heritage-voice-thread-map [class*='summary'],
.vcm-shell--threadmap .heritage-voice-thread-map [class*='description'],
.vcm-shell--threadmap .heritage-voice-thread-map [class*='eyebrow'],
.vcm-shell--threadmap .heritage-voice-thread-map [class*='headline'],
.vcm-shell--threadmap .heritage-voice-thread-map [class*='title'],
.vcm-shell--threadmap .heritage-voice-thread-map [class*='copy'],
.vcm-shell--threadmap .heritage-voice-thread-map [class*='readout'] {
  display: none !important;

  opacity: 0 !important;

  visibility: hidden !important;

  pointer-events: none !important;
}

/* Keep SVG/icons/canvas layers visible even if their parents use generic words. */

.vcm-shell--threadmap .heritage-voice-thread-map svg,
.vcm-shell--threadmap .heritage-voice-thread-map path,
.vcm-shell--threadmap .heritage-voice-thread-map polygon,
.vcm-shell--threadmap .heritage-voice-thread-map line,
.vcm-shell--threadmap .heritage-voice-thread-map circle,
.vcm-shell--threadmap .heritage-voice-thread-map button,
.vcm-shell--threadmap .heritage-voice-thread-map [class*='node'],
.vcm-shell--threadmap .heritage-voice-thread-map [class*='icon'],
.vcm-shell--threadmap .heritage-voice-thread-map [class*='shape'],
.vcm-shell--threadmap .heritage-voice-thread-map [class*='thread'],
.vcm-shell--threadmap .heritage-voice-thread-map [class*='map'],
.vcm-shell--threadmap .heritage-voice-thread-map [class*='graph'],
.vcm-shell--threadmap .heritage-voice-thread-map [class*='svg'] {
  visibility: visible !important;
}

/* The click target layer is not needed here and can create stray invisible hit zones. */

.vcm-shell--threadmap .vcm-node-click-layer,
.vcm-shell--threadmap .vcm-node-click-layer *,
.vcm-shell--threadmap .vcm-node-click-target {
  display: none !important;

  opacity: 0 !important;

  visibility: hidden !important;

  pointer-events: none !important;
}

/* Remove old similarity artifacts. */

.vcm-shell--threadmap .vcm-similarity,
.vcm-shell--threadmap .vcm-similarity *,
.vcm-shell--threadmap .vcm-first-listen-card {
  display: none !important;

  opacity: 0 !important;

  visibility: hidden !important;

  pointer-events: none !important;
}

/* Playground owns the bottom read summary/tabs. Keep them above the map cleanly. */

.vp-stage .vp-read-summary {
  position: relative !important;

  z-index: 40 !important;

  margin: -34px auto 0 !important;
}

.vp-stage .vp-read-mode-dock {
  position: relative !important;

  z-index: 41 !important;

  margin-top: 10px !important;
}

/* Add a soft fade behind the Playground-owned lower read section so the graph

   doesn't visually collide with the tabs. */

.vp-stage .vp-read-summary::before {
  content: '' !important;

  position: absolute !important;

  z-index: -1 !important;

  left: -42px !important;

  right: -42px !important;

  top: -22px !important;

  bottom: -18px !important;

  pointer-events: none !important;

  background: radial-gradient(
    ellipse at center,

    rgba(3, 5, 12, 0.86),
    rgba(3, 5, 12, 0.48) 52%,

    transparent 76%
  ) !important;
}

/* Medium desktop tuning */

@media (max-width: 1320px) {
  .vcm-shell--threadmap {
    min-height: 490px !important;
  }

  .vcm-shell--threadmap .vcm-map-frame {
    height: 430px !important;
  }

  .vcm-shell--threadmap .heritage-voice-thread-map {
    max-width: 610px !important;

    transform: translateY(-14px) scale(0.94) !important;
  }

  .vp-stage .vp-read-summary {
    margin-top: -38px !important;
  }
}

/* Large desktop tuning */

@media (min-width: 1500px) {
  .vcm-shell--threadmap {
    min-height: 530px !important;
  }

  .vcm-shell--threadmap .vcm-map-frame {
    height: 475px !important;
  }

  .vcm-shell--threadmap .heritage-voice-thread-map {
    max-width: 690px !important;

    transform: translateY(-20px) scale(0.98) !important;
  }

  .vp-stage .vp-read-summary {
    margin-top: -36px !important;
  }
}
