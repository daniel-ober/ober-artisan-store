.vcm-shell.vcm-mode-first-listen .vcm-node.is-first-listen {
  opacity: 1 !important;
}

/* Circle/dot fallback */

.vcm-shell[data-read-mode='firstListen'] circle,
.vcm-shell.is-first-listen circle,
.vcm-shell.vcm-mode-first-listen circle {
